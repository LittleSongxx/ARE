*.ply
*.pth.back

# Ignored source subdirectories
src/DARE/
src/HDPlanner_Exp_and_Nav/
src/ariadne2_opt
src/ariadne_wavelet

# Package assets/artifacts under src
maps/
src/**/maps/
src/**/gifs/
src/**/gifts/
src/**/eval/
src/**/result/
src/**/model/

# Training results
src/*/results/

# AC-PBGRL is intentionally self-contained; its fixed paper benchmark maps are
# versioned with the implementation despite the general workspace map rule.
!src/AC-PBGRL/maps/
!src/AC-PBGRL/maps/**

# Exploration results
exploration_results/

# Temp files
diff.txt
offline_bundle/

# Vehicle simulator logs
src/autonomous_exploration_development_environment/src/vehicle_simulator/log/

